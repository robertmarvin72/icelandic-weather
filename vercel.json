{
  "crons": [
    {
      "path": "/api/cron/generate-blog-draft",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/refresh-aurora",
      "schedule": "0 12,20 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog-meta?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],

  "functions": {
    "api/**/*.js": {
      "includeFiles": "server_data/**"
    }
  },

  "headers": [
    {
      "source": "/research/decision-quiz",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "connect-src 'self' https://script.google.com https://script.googleusercontent.com"
        }
      ]
    }
  ]
}
