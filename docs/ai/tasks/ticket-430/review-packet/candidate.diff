+  it("EN and IS copy are actually distinct (not an accidental copy-paste)", () => {
+    for (const key of AFFILIATE_KEYS) {
+      expect(northernLightsTranslations.en[key]).not.toBe(northernLightsTranslations.is[key]);
+    }
+  });
+});
